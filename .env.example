# Єдиний файл конфігурації — .env у корені репозиторію.
# Збережіть старі DB_* для явної міграції; звичайний запуск їх не використовує.
BOT_TOKEN=your_telegram_bot_token_here
DATABASE_PATH=data/meditrack.sqlite3
DEVICE_ID=meditrack-01
# Власний числовий Telegram ID (приватний чат із ботом).
OWNER_TELEGRAM_ID=0
# Згенеруйте: python -c "import secrets; print(secrets.token_hex(32))"
# Те саме значення встановіть у firmware/MediTrack/secrets.h.
DEVICE_SECRET=
# Для доступу ESP32 у локальній мережі: 0.0.0.0; за замовчуванням лише localhost.
API_HOST=127.0.0.1
API_PORT=5000

# Лише для читання старої БД через явну команду міграції.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medication_db
